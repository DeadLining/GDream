AI_COMIC_DATABASE_URL=sqlite:///./data/studio.db
AI_COMIC_DATA_ROOT=./data
# Opt in only while editing API code; reload can interrupt background model jobs.
AI_COMIC_API_RELOAD=0
# Optional: absolute path to the preinstalled HostBridge 2.0.0 executable.
AI_COMIC_HOSTBRIDGE_EXECUTABLE=hostbridge
# To share the CS Bridge daemon, use <repo>/scripts/hostbridge-cs-bridge above.
# Override only when CS Bridge's vendored HostBridge runtime is installed elsewhere.
CS_BRIDGE_HOSTBRIDGE_ROOT=/Applications/CS Bridge.app/Contents/Resources/vendor/hostbridge
# HostBridge daemon that owns the configured hosts; ~ is expanded by the API.
# Optional override; the default is /private/tmp/hostbridge-<current-user>/daemon.sock.
# AI_COMIC_HOSTBRIDGE_DAEMON_SOCKET=/custom/path/daemon.sock
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_VIDEO_BASE_URL=https://api.minimaxi.com
MINIMAX_VIDEO_API_KEY=
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
GPT_IMAGE_BASE_URL=http://192.168.18.80:14000
GPT_IMAGE_KEY=
GPT_IMAGE_MODEL=gpt-image-2
QWEN_TTS_BASE_URL=http://192.168.18.94:18080
QWEN_TTS_SSH_HOST=ai-comic-tts
QWEN_TTS_NARRATOR_SPEAKER=dylan
COMPOSITOR_ROOT=./packages/compositor
