{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/h3-prompt-writing/action-timeline.schema.json",
  "title": "H3 Layer 1 Action Timeline",
  "type": "object",
  "required": [
    "creative_intent",
    "duration",
    "mode",
    "subjects_and_objects",
    "world_and_spatial_anchors",
    "action_timeline",
    "continuity_contract",
    "warnings"
  ],
  "properties": {
    "creative_intent": { "type": "string", "minLength": 1 },
    "duration": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)? seconds$" },
    "mode": { "enum": ["T2VA", "I2VA", "FL2VA", "L2VA", "REF2VA"] },
    "subjects_and_objects": { "type": ["object", "string"], "minLength": 1 },
    "world_and_spatial_anchors": { "type": "string", "minLength": 1 },
    "action_timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "time",
          "start_state",
          "primary_action",
          "contact_or_path",
          "visible_result",
          "exit_state",
          "camera_visibility",
          "sound"
        ],
        "properties": {
          "time": { "type": "string", "pattern": "^\\d{2}:\\d{2}\\.\\d{3}-\\d{2}:\\d{2}\\.\\d{3}$" },
          "start_state": { "type": "string", "minLength": 1 },
          "primary_action": { "type": "string", "minLength": 1 },
          "contact_or_path": { "type": "string", "minLength": 1 },
          "visible_result": { "type": "string", "minLength": 1 },
          "exit_state": { "type": "string", "minLength": 1 },
          "camera_visibility": { "type": "string", "minLength": 1 },
          "sound": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "continuity_contract": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
