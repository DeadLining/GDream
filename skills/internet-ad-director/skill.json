{
  "id": "internet-ad-director",
  "name": "广告导演",
  "icon": "clapperboard",
  "description": "互联网广告导演：病毒广告创意策略 + 分镜 + 提示词 + 生成，顾问与执行一体",
  "version": "1.0.0",
  "hasPanel": true,
  "accentColor": "rose",
  "placeholder": "补充说明（可选）：上线节点 / 预算 / 调性 / 参考案例…",
  "panel": {
    "fields": [
      {
        "key": "product",
        "label": "产品 / 品牌",
        "type": "input",
        "placeholder": "如：某新锐气泡水 / 品牌名（必填）"
      },
      {
        "key": "brief",
        "label": "创意需求 brief",
        "type": "textarea",
        "placeholder": "核心诉求、卖点、背景、想要的感觉…（必填）"
      },
      {
        "key": "audience",
        "label": "受众",
        "type": "select",
        "default": "大众消费者",
        "options": [
          {
            "value": "政府/监管",
            "label": "政府 / 监管（正式、重合规）"
          },
          {
            "value": "合作商/渠道",
            "label": "合作商 / 渠道（要具体条款）"
          },
          {
            "value": "大众消费者",
            "label": "大众消费者（可轻松、可抽象）"
          },
          {
            "value": "投资人",
            "label": "投资人（要可核查数据）"
          },
          {
            "value": "内部员工",
            "label": "内部员工（重意义感）"
          }
        ]
      },
      {
        "key": "productCategory",
        "label": "产品形态",
        "type": "select",
        "default": "快销品",
        "options": [
          {
            "value": "实体产品",
            "label": "实体产品（看形制与使用场景）"
          },
          {
            "value": "快销品",
            "label": "快销品（看感官与复购理由）"
          },
          {
            "value": "软件/服务",
            "label": "软件 / 服务（看问题—解法与真实界面）"
          }
        ]
      },
      {
        "key": "objective",
        "label": "传播目标",
        "type": "select",
        "default": "品牌认知",
        "options": [
          {
            "value": "品牌认知",
            "label": "品牌认知（可抽象，重记忆点）"
          },
          {
            "value": "产品/能力说明",
            "label": "产品 / 能力说明（要具体）"
          },
          {
            "value": "招商/渠道招募",
            "label": "招商 / 渠道招募（要具体条款）"
          },
          {
            "value": "政策/价值宣导",
            "label": "政策 / 价值宣导（重合规）"
          },
          {
            "value": "直接转化",
            "label": "直接转化（必须带 CTA）"
          }
        ]
      },
      {
        "key": "market",
        "label": "目标市场",
        "type": "select",
        "default": "中国",
        "options": [
          {
            "value": "中国",
            "label": "中国"
          },
          {
            "value": "美欧",
            "label": "美欧"
          },
          {
            "value": "东南亚",
            "label": "东南亚"
          },
          {
            "value": "印度",
            "label": "印度"
          },
          {
            "value": "中东",
            "label": "中东"
          },
          {
            "value": "拉美",
            "label": "拉美"
          },
          {
            "value": "全球",
            "label": "全球"
          }
        ]
      },
      {
        "key": "platform",
        "label": "投放平台",
        "type": "select",
        "default": "抖音",
        "options": [
          {
            "value": "抖音",
            "label": "抖音"
          },
          {
            "value": "小红书",
            "label": "小红书"
          },
          {
            "value": "视频号",
            "label": "视频号"
          },
          {
            "value": "B站",
            "label": "B站"
          },
          {
            "value": "快手",
            "label": "快手"
          },
          {
            "value": "TikTok",
            "label": "TikTok"
          },
          {
            "value": "YouTube",
            "label": "YouTube"
          },
          {
            "value": "Instagram",
            "label": "Instagram"
          }
        ]
      }
    ]
  },
  "promptTemplate": "[广告导演] 请参考 ~/.gdream/skills/internet-ad-director/SKILL.md 扮演互联网广告导演。\n产品/品牌：{{product}}　目标市场：{{market}}　投放平台：{{platform}}\n创意需求：{{brief}}\n{{userContent}}\n\n先出创意策略方案（病毒元素匹配 + 导演风格推荐 + 短视频结构，按需联名/情绪雷达/整合营销），给我确认后再逐步落地：分镜表 → @图片N 提示词 →（确认后）seedance 生成。人群/病毒元素/导演风格未指定时由你分析推荐。缺产品或 brief 时先反问。每个消耗资源的节点（生图/生视频）先给完整方案、我确认后才执行。"
}
