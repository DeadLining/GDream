[Unit]
Description=AI Comic Studio Qwen3 TTS
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-comic-studio/qwen3-tts
Environment=CUDA_VISIBLE_DEVICES=0
Environment=QWEN_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
Environment=HF_HOME=/opt/ai-comic-studio/qwen3-tts/models/huggingface
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=HTTPS_PROXY=http://127.0.0.1:7890
ExecStart=/opt/ai-comic-studio/qwen3-tts/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 18080 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
